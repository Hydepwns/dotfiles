{{- $name := promptStringOnce . "name" "Display name" -}}
{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $github := promptStringOnce . "github" "GitHub username" -}}
{{- $age_recipient := promptStringOnce . "age_recipient" "Age public key (press Enter to skip, generate later with: make setup-age)" -}}

# Generated from .chezmoi.toml.tmpl -- edit the template, not this file
{{ if $age_recipient -}}
encryption = "age"
{{ end -}}
sourceDir = "{{ .chezmoi.workingTree }}/home"

[data]
# User identity (prompted on first chezmoi init)
name = {{ $name | quote }}
email = {{ $email | quote }}
github = {{ $github | quote }}
{{ if $age_recipient -}}
age_recipient = {{ $age_recipient | quote }}
{{ end -}}

# Shell configuration
gpg_signing_key = "1938C94528268692"
oh_my_zsh_theme = "robbyrussell"
oh_my_zsh_plugins = "git"
starship = true
personal = true

# Tool configurations
rust = true
ohmyzsh = true
mise = true
emacs = true
elixir = true
erlang = true
lua = true
direnv = true
devenv = false
nix = true
llvm = false
postgres = false
psql = false
foundry = false
huff = false
solana = false
orbstack = true
tailscale = true
onepassword = true
aws = true
infisical = true
paperwm = true
raycast = true
work = false
datadog = false
sentry = false
signoz = true

# Agent MCP servers (from DROOdotFOO/agent-skills)
coingecko = true
digest = true
recall = true
autoresearch = true
watchdog = true
prepper = true
sentinel = true
patchbot = true
regen = true

# MCP/Observability
datadog_site = "us5.datadoghq.com"
signoz_url = "http://mini-axol.tail9b2ce8.ts.net:3301"
regen_url = "http://mini-axol.tail9b2ce8.ts.net:3302" # open mode behind Tailscale; no auth

# Platform-specific
{{- if and (eq .chezmoi.os "darwin") (eq .chezmoi.arch "arm64") }}
brewPrefix = "/opt/homebrew"
{{- else }}
brewPrefix = "/usr/local"
{{- end }}

# Synthwave84 Theme
[data.theme]
name = "Synthwave84"
bg = "#262335"
bg_dark = "#241b2f"
bg_light = "#2a2139"
fg = "#ffffff"
fg_dim = "#848bbd"
accent = "#ff7edb"
accent2 = "#36f9f6"
cursor = "#ff7edb"
selection_bg = "#ff7edb"
selection_fg = "#241b2f"
border = "#495495"
black = "#241b2f"
red = "#fe4450"
green = "#72f1b8"
yellow = "#fede5d"
blue = "#03edf9"
magenta = "#ff7edb"
cyan = "#36f9f6"
white = "#ffffff"
bright_black = "#495495"
bright_red = "#fe4450"
bright_green = "#72f1b8"
bright_yellow = "#fede5d"
bright_blue = "#03edf9"
bright_magenta = "#ff7edb"
bright_cyan = "#36f9f6"
bright_white = "#ffffff"

# Synthwave84 Soft -- the variant Zed uses ("Synthwave84 Soft" in zed/settings.json).
# Lower contrast than the base palette above, and it carries the syntax roles the base
# block lacks. Consumed by the Emacs theme. Source of truth is the shipped Zed theme:
# ~/Library/Application Support/Zed/extensions/installed/synthwave84/themes/synthwave84.json
# ANSI/terminal colors are deliberately absent -- Zed's Soft variant reuses the base ANSI
# palette above, so terminal faces stay identical to Ghostty.
[data.theme.soft]
name = "Synthwave84 Soft"
bg = "#2e2a3e"
bg_dark = "#2a2139"
bg_light = "#332e42"
fg = "#f0f0f0"
# Flattened from Zed's alpha colors over bg: #f0f0f080 and #f0f0f073 respectively.
fg_dim = "#8f8d97"
fg_subtle = "#85838e"
accent = "#ff92e0"
accent2 = "#5af5f3"
cursor = "#ff92e0"
selection_bg = "#4e4570"
selection_fg = "#f0f0f0"
border = "#5a5f8d"
border_focus = "#9933aa"
comment = "#848bbd"
keyword = "#fee380"
string = "#ffa15a"
string_escape = "#85f3c3"
number = "#fa9890"
constant = "#fa9890"
function = "#5af5f3"
variable = "#ff92e0"
type = "#ff92e0"
property = "#ff92e0"
operator = "#fee380"
punctuation = "#f0f0f0"
preproc = "#ff92e0"
link = "#85f3c3"
error = "#fe6670"
warning = "#fee380"
info = "#33f0fc"
success = "#85f3c3"
hint = "#33f0fc"
git_added = "#85f3c3"
git_modified = "#fee380"
git_deleted = "#fe6670"

[git]
autoCommit = true
autoPush = false

{{ if $age_recipient -}}
[age]
# To use 1Password-backed decryption (no key on disk), create ~/.config/chezmoi/age-op-decrypt.sh
# Otherwise, use a plaintext key file: identity = "~/.config/chezmoi/age_key.txt"
{{ if stat (joinPath .chezmoi.homeDir ".config/chezmoi/age-op-decrypt.sh") -}}
# Absolute path required: chezmoi execs age.command without shell tilde expansion.
command = {{ (joinPath .chezmoi.homeDir ".config/chezmoi/age-op-decrypt.sh") | quote }}
{{ else -}}
identity = "~/.config/chezmoi/age_key.txt"
{{ end -}}
recipient = {{ $age_recipient | quote }}
{{ end -}}

[template]
options = ["missingkey=error"]

[diff]
pager = ""

[status]
pathStyle = "relative"
